          ],
          "interpreterVersion": 1,
          "code": "/**\n * HUUM HIVE Wood 17 ash drawer: an open steel tray that slides into the\n * bottom of the firebox, a front plate that closes the drawer opening, and a\n * U-shaped pull. Its position also sets the air supply. Z up, front faces -Y.\n */\nfunction run(\n  fireboxFrontY: number = -312.5,\n  trayWidth: number = 245,\n  trayDepth: number = 460,\n  trayBottom: number = 35, // on the firebox floor\n  trayHeight: number = 55,\n  sheet: number = 2,\n  frontWidth: number = 270,\n  frontBottom: number = 35,\n  frontTop: number = 100,\n  frontThickness: number = 15,\n  handleLength: number = 120,\n  handleStandoff: number = 15,\n  color: string = \"#3A3B3D\",\n): Assembly {\n  // Box from its extents (makeBaseBox is centred in X and Y, base at z = 0)\n  const box = (x0: number, x1: number, y0: number, y1: number, z0: number, z1: number) =>\n    replicad.makeBaseBox(x1 - x0, y1 - y0, z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, z0);\n\n  // Open-topped tray behind the front plate\n  const tw = trayWidth / 2;\n  const trayBack = fireboxFrontY + trayDepth;\n  const tray = box(-tw, tw, fireboxFrontY, trayBack, trayBottom, trayBottom + trayHeight).cut(\n    box(-tw + sheet, tw - sheet, fireboxFrontY + sheet, trayBack - sheet, trayBottom + sheet, trayBottom + trayHeight + 1),\n  );\n\n  // Front plate in front of the firebox face\n  const frontY = fireboxFrontY - frontThickness;\n  const front = box(-frontWidth / 2, frontWidth / 2, frontY, fireboxFrontY, frontBottom, frontTop);\n\n  // U-shaped pull: grip bar on two short legs\n  const midZ = (frontBottom + frontTop) / 2;\n  const bar = 10;\n  const gripY = frontY - handleStandoff;\n  const grip = box(-handleLength / 2, handleLength / 2, gripY, gripY + 5, midZ - bar / 2, midZ + bar / 2);\n  const legX = handleLength / 2 - bar / 2;\n  const leg = (x: number) => box(x - bar / 2, x + bar / 2, gripY + 5, frontY, midZ - bar / 2, midZ + bar / 2);\n\n  const drawer = tray.fuse(front).fuse(grip).fuse(leg(-legX)).fuse(leg(legX));\n  return new Assembly({ geometry: drawer, color, tags: [\"steel\", \"ash drawer\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * HUUM HIVE Wood 17 ash drawer: an open steel tray that slides into the\n * bottom of the firebox, a front plate that closes the drawer opening, and a\n * U-shaped pull. Its position also sets the air supply. Z up, front faces -Y.\n */\nfunction run(fireboxFrontY = -312.5, trayWidth = 245, trayDepth = 460, trayBottom = 35, // on the firebox floor\ntrayHeight = 55, sheet = 2, frontWidth = 270, frontBottom = 35, frontTop = 100, frontThickness = 15, handleLength = 120, handleStandoff = 15, color = \"#3A3B3D\") {\n    // Box from its extents (makeBaseBox is centred in X and Y, base at z = 0)\n    const box = (x0, x1, y0, y1, z0, z1) => replicad.makeBaseBox(x1 - x0, y1 - y0, z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, z0);\n    // Open-topped tray behind the front plate\n    const tw = trayWidth / 2;\n    const trayBack = fireboxFrontY + trayDepth;\n    const tray = box(-tw, tw, fireboxFrontY, trayBack, trayBottom, trayBottom + trayHeight).cut(box(-tw + sheet, tw - sheet, fireboxFrontY + sheet, trayBack - sheet, trayBottom + sheet, trayBottom + trayHeight + 1));\n    // Front plate in front of the firebox face\n    const frontY = fireboxFrontY - frontThickness;\n    const front = box(-frontWidth / 2, frontWidth / 2, frontY, fireboxFrontY, frontBottom, frontTop);\n    // U-shaped pull: grip bar on two short legs\n    const midZ = (frontBottom + frontTop) / 2;\n    const bar = 10;\n    const gripY = frontY - handleStandoff;\n    const grip = box(-handleLength / 2, handleLength / 2, gripY, gripY + 5, midZ - bar / 2, midZ + bar / 2);\n    const legX = handleLength / 2 - bar / 2;\n    const leg = (x) => box(x - bar / 2, x + bar / 2, gripY + 5, frontY, midZ - bar / 2, midZ + bar / 2);\n    const drawer = tray.fuse(front).fuse(grip).fuse(leg(-legX)).fuse(leg(legX));\n    return new Assembly({ geometry: drawer, color, tags: [\"steel\", \"ash drawer\"] });\n}\n"
        }
      ],
