          "interpreterVersion": 1,
          "code": "/**\n * HUUM HIVE Wood 17 firebox: a welded 5 mm steel box that sits inside the\n * stone cage and sticks out 35 mm past it at the front (manual E).\n * The front has the door opening above the ash drawer opening; the top has\n * the hole the flue collar stands over. Z is up, the front faces -Y.\n */\nfunction run(\n  width: number = 300, // manual G\n  frontY: number = -312.5, // cage radius 277.5 + 35 mm projection\n  depth: number = 540,\n  bottomZ: number = 30, // on top of the base runners\n  topZ: number = 460, // manual D\n  wall: number = 5, // manual: furnace walls 5 mm\n  doorOpeningWidth: number = 230,\n  doorOpeningBottom: number = 125,\n  doorOpeningTop: number = 415,\n  drawerOpeningWidth: number = 250,\n  drawerOpeningTop: number = 95,\n  flueDiameter: number = 115,\n  color: string = \"#2E2F31\",\n): Assembly {\n  // Box from its extents (makeBaseBox is centred in X and Y, base at z = 0)\n  const box = (x0: number, x1: number, y0: number, y1: number, z0: number, z1: number) =>\n    replicad.makeBaseBox(x1 - x0, y1 - y0, z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, z0);\n  const hw = width / 2;\n  const backY = frontY + depth;\n  let body = box(-hw, hw, frontY, backY, bottomZ, topZ).cut(\n    box(-hw + wall, hw - wall, frontY + wall, backY - wall, bottomZ + wall, topZ - wall),\n  );\n\n  // Openings through the front wall\n  const frontCut = (w: number, z0: number, z1: number) =>\n    box(-w / 2, w / 2, frontY - 1, frontY + wall + 1, z0, z1);\n  body = body.cut(frontCut(doorOpeningWidth, doorOpeningBottom, doorOpeningTop));\n  body = body.cut(frontCut(drawerOpeningWidth, bottomZ + wall, drawerOpeningTop));\n\n  // Smoke outlet in the top, centred on the cage axis, matching the collar's bore\n  const flue = replicad\n    .makeCylinder(flueDiameter / 2 - 3, wall + 2)\n    .translate(0, 0, topZ - wall - 1);\n  body = body.cut(flue);\n\n  return new Assembly({ geometry: body, color, tags: [\"steel\", \"firebox\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * HUUM HIVE Wood 17 firebox: a welded 5 mm steel box that sits inside the\n * stone cage and sticks out 35 mm past it at the front (manual E).\n * The front has the door opening above the ash drawer opening; the top has\n * the hole the flue collar stands over. Z is up, the front faces -Y.\n */\nfunction run(width = 300, // manual G\nfrontY = -312.5, // cage radius 277.5 + 35 mm projection\ndepth = 540, bottomZ = 30, // on top of the base runners\ntopZ = 460, // manual D\nwall = 5, // manual: furnace walls 5 mm\ndoorOpeningWidth = 230, doorOpeningBottom = 125, doorOpeningTop = 415, drawerOpeningWidth = 250, drawerOpeningTop = 95, flueDiameter = 115, color = \"#2E2F31\") {\n    // Box from its extents (makeBaseBox is centred in X and Y, base at z = 0)\n    const box = (x0, x1, y0, y1, z0, z1) => replicad.makeBaseBox(x1 - x0, y1 - y0, z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, z0);\n    const hw = width / 2;\n    const backY = frontY + depth;\n    let body = box(-hw, hw, frontY, backY, bottomZ, topZ).cut(box(-hw + wall, hw - wall, frontY + wall, backY - wall, bottomZ + wall, topZ - wall));\n    // Openings through the front wall\n    const frontCut = (w, z0, z1) => box(-w / 2, w / 2, frontY - 1, frontY + wall + 1, z0, z1);\n    body = body.cut(frontCut(doorOpeningWidth, doorOpeningBottom, doorOpeningTop));\n    body = body.cut(frontCut(drawerOpeningWidth, bottomZ + wall, drawerOpeningTop));\n    // Smoke outlet in the top, centred on the cage axis, matching the collar's bore\n    const flue = replicad\n        .makeCylinder(flueDiameter / 2 - 3, wall + 2)\n        .translate(0, 0, topZ - wall - 1);\n    body = body.cut(flue);\n    return new Assembly({ geometry: body, color, tags: [\"steel\", \"firebox\"] });\n}\n"
