              ],
              "interpreterVersion": 1,
              "code": "/**\n * HUUM HIVE Wood 17 door glass: a tempered pane that fills the door window,\n * sitting in the middle of the door's thickness. Matches the window outline\n * in the Door molecule. Z up, faces -Y.\n */\nfunction run(\n  fireboxFrontY: number = -312.5,\n  doorThickness: number = 15,\n  width: number = 174,\n  bottom: number = 146,\n  top: number = 380,\n  chamfer: number = 25,\n  thickness: number = 5,\n  color: string = \"#2B1A10\",\n): Assembly {\n  const pane = replicad\n    .draw([-width / 2, bottom])\n    .lineTo([width / 2, bottom])\n    .lineTo([width / 2, top - chamfer])\n    .lineTo([width / 2 - chamfer, top])\n    .lineTo([-width / 2 + chamfer, top])\n    .lineTo([-width / 2, top - chamfer])\n    .close();\n  const y = fireboxFrontY - (doorThickness - thickness) / 2;\n  const glass = pane.sketchOnPlane(\"XZ\").extrude(thickness).translate(0, y, 0);\n  return new Assembly({ geometry: glass, color, tags: [\"glass\"] });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * HUUM HIVE Wood 17 door glass: a tempered pane that fills the door window,\n * sitting in the middle of the door's thickness. Matches the window outline\n * in the Door molecule. Z up, faces -Y.\n */\nfunction run(fireboxFrontY = -312.5, doorThickness = 15, width = 174, bottom = 146, top = 380, chamfer = 25, thickness = 5, color = \"#2B1A10\") {\n    const pane = replicad\n        .draw([-width / 2, bottom])\n        .lineTo([width / 2, bottom])\n        .lineTo([width / 2, top - chamfer])\n        .lineTo([width / 2 - chamfer, top])\n        .lineTo([-width / 2 + chamfer, top])\n        .lineTo([-width / 2, top - chamfer])\n        .close();\n    const y = fireboxFrontY - (doorThickness - thickness) / 2;\n    const glass = pane.sketchOnPlane(\"XZ\").extrude(thickness).translate(0, y, 0);\n    return new Assembly({ geometry: glass, color, tags: [\"glass\"] });\n}\n"
            }
