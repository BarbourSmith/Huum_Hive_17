          "interpreterVersion": 1,
          "code": "/**\n * HUUM HIVE Wood 17 stone cage: a welded basket of round-rod rings on an\n * egg-shaped profile, held by flat straps. Rings below the firebox top are\n * open at the front, ending on two front plates beside the firebox.\n * Z is up, the firebox faces -Y, and the cage is centred on the Z axis.\n * The members are kept as one compound rather than fused: fusing closed\n * rings leaves faces that fail to mesh.\n */\nfunction run(\n  maxDiameter: number = 555, // steel frame diameter (manual)\n  bulgeZ: number = 400, // height of the widest ring\n  bottomZ: number = 60, // gap under the cage (manual)\n  topZ: number = 750, // overall height (manual)\n  bottomDiameter: number = 490,\n  topDiameter: number = 390,\n  ringCount: number = 15,\n  rodDiameter: number = 8,\n  fireboxHalfWidth: number = 150, // firebox is 300 mm wide (manual G)\n  fireboxTop: number = 460, // top of firebox above floor (manual D)\n  strapWidth: number = 25,\n  strapThickness: number = 4,\n  frontPlateDepth: number = 40,\n  color: string = \"#B9BDC2\",\n): Assembly {\n  const Rm = maxDiameter / 2;\n  // Outer radius of the cage at height z: two half-ellipses meeting at bulgeZ\n  const aBelow = (bulgeZ - bottomZ) / Math.sqrt(1 - (bottomDiameter / 2 / Rm) ** 2);\n  const aAbove = (topZ - bulgeZ) / Math.sqrt(1 - (topDiameter / 2 / Rm) ** 2);\n  const R = (z: number) => {\n    const a = z < bulgeZ ? aBelow : aAbove;\n    const t = Math.min(1, Math.abs(z - bulgeZ) / a);\n    return Rm * Math.sqrt(1 - t * t);\n  };\n  const rod = rodDiameter / 2;\n  const halfOpen = fireboxHalfWidth + 10; // rings stop inside the front plates\n  const plateX = fireboxHalfWidth + 8; // inner face of each front plate\n\n  // Ring heights, evenly spaced from the bottom to the top of the cage\n  const ringZ: number[] = [];\n  for (let i = 0; i < ringCount; i++) {\n    ringZ.push(bottomZ + rod + (i * (topZ - bottomZ - rodDiameter)) / (ringCount - 1));\n  }\n  // Rings that would hit the firebox are open at the front; the plates run up to the first closed ring\n  const firstClosed = ringZ.findIndex((z) => z - rod > fireboxTop);\n  const plateTop = ringZ[firstClosed];\n  // Straps run between the bottom and top ring centrelines\n  const strapBottom = ringZ[0];\n\n  const members: any[] = [];\n\n  ringZ.forEach((z, i) => {\n    const rc = R(z) - rod;\n    let ring = replicad\n      .drawCircle(rod)\n      .translate(rc, z)\n      .sketchOnPlane(\"XZ\")\n      .revolve([0, 0, 1], { origin: [0, 0, 0] });\n    if (i < firstClosed) {\n      // makeBaseBox is centred in X and Y: this one spans |x| < halfOpen in front of the axis\n      const cutter = replicad\n        .makeBaseBox(2 * halfOpen, Rm + 50, rodDiameter + 2)\n        .translate(0, -(Rm + 50) / 2, z - rod - 1);\n      ring = ring.cut(cutter);\n    }\n    members.push(ring);\n  });\n\n  // Sampled heights for the strap outlines\n  const steps = 24;\n  const zs = (z0: number, z1: number) =>\n    Array.from({ length: steps + 1 }, (_, k) => z0 + ((z1 - z0) * k) / steps);\n\n  // Side and back straps: flat bars just inside the rings, welded to them\n  const ribZ = zs(strapBottom, ringZ[ringCount - 1]);\n  let rib = replicad.draw([R(ribZ[0]) - rod, ribZ[0]]);\n  ribZ.slice(1).forEach((z) => (rib = rib.lineTo([R(z) - rod, z])));\n  [...ribZ].reverse().forEach((z) => (rib = rib.lineTo([R(z) - rod - strapWidth, z])));\n  const ribSolid = rib\n    .close()\n    .sketchOnPlane(\"XZ\")\n    .extrude(strapThickness)\n    .translate(0, strapThickness / 2, 0);\n  [0, 90, 180].forEach((deg) => members.push(ribSolid.clone().rotate(deg, [0, 0, 0], [0, 0, 1])));\n\n  // Front plates beside the firebox, outer edge flush with the rings\n  const plateOuterX = plateX + strapThickness;\n  const pz = zs(strapBottom, plateTop);\n  const yo = (z: number) => -Math.sqrt(R(z) ** 2 - plateOuterX ** 2);\n  let plate = replicad.draw([yo(pz[0]), pz[0]]);\n  pz.slice(1).forEach((z) => (plate = plate.lineTo([yo(z), z])));\n  [...pz].reverse().forEach((z) => (plate = plate.lineTo([yo(z) + frontPlateDepth, z])));\n  const plateSolid = plate.close().sketchOnPlane(\"YZ\").extrude(strapThickness);\n  members.push(plateSolid.clone().translate(plateX, 0, 0));\n  members.push(plateSolid.translate(-plateX - strapThickness, 0, 0));\n\n  return new Assembly({\n    geometry: replicad.makeCompound(members),\n    color,\n    tags: [\"stainless steel\", \"stone cage\"],\n  });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * HUUM HIVE Wood 17 stone cage: a welded basket of round-rod rings on an\n * egg-shaped profile, held by flat straps. Rings below the firebox top are\n * open at the front, ending on two front plates beside the firebox.\n * Z is up, the firebox faces -Y, and the cage is centred on the Z axis.\n * The members are kept as one compound rather than fused: fusing closed\n * rings leaves faces that fail to mesh.\n */\nfunction run(maxDiameter = 555, // steel frame diameter (manual)\nbulgeZ = 400, // height of the widest ring\nbottomZ = 60, // gap under the cage (manual)\ntopZ = 750, // overall height (manual)\nbottomDiameter = 490, topDiameter = 390, ringCount = 15, rodDiameter = 8, fireboxHalfWidth = 150, // firebox is 300 mm wide (manual G)\nfireboxTop = 460, // top of firebox above floor (manual D)\nstrapWidth = 25, strapThickness = 4, frontPlateDepth = 40, color = \"#B9BDC2\") {\n    const Rm = maxDiameter / 2;\n    // Outer radius of the cage at height z: two half-ellipses meeting at bulgeZ\n    const aBelow = (bulgeZ - bottomZ) / Math.sqrt(1 - (bottomDiameter / 2 / Rm) ** 2);\n    const aAbove = (topZ - bulgeZ) / Math.sqrt(1 - (topDiameter / 2 / Rm) ** 2);\n    const R = (z) => {\n        const a = z < bulgeZ ? aBelow : aAbove;\n        const t = Math.min(1, Math.abs(z - bulgeZ) / a);\n        return Rm * Math.sqrt(1 - t * t);\n    };\n    const rod = rodDiameter / 2;\n    const halfOpen = fireboxHalfWidth + 10; // rings stop inside the front plates\n    const plateX = fireboxHalfWidth + 8; // inner face of each front plate\n    // Ring heights, evenly spaced from the bottom to the top of the cage\n    const ringZ = [];\n    for (let i = 0; i < ringCount; i++) {\n        ringZ.push(bottomZ + rod + (i * (topZ - bottomZ - rodDiameter)) / (ringCount - 1));\n    }\n    // Rings that would hit the firebox are open at the front; the plates run up to the first closed ring\n    const firstClosed = ringZ.findIndex((z) => z - rod > fireboxTop);\n    const plateTop = ringZ[firstClosed];\n    // Straps run between the bottom and top ring centrelines\n    const strapBottom = ringZ[0];\n    const members = [];\n    ringZ.forEach((z, i) => {\n        const rc = R(z) - rod;\n        let ring = replicad\n            .drawCircle(rod)\n            .translate(rc, z)\n            .sketchOnPlane(\"XZ\")\n            .revolve([0, 0, 1], { origin: [0, 0, 0] });\n        if (i < firstClosed) {\n            // makeBaseBox is centred in X and Y: this one spans |x| < halfOpen in front of the axis\n            const cutter = replicad\n                .makeBaseBox(2 * halfOpen, Rm + 50, rodDiameter + 2)\n                .translate(0, -(Rm + 50) / 2, z - rod - 1);\n            ring = ring.cut(cutter);\n        }\n        members.push(ring);\n    });\n    // Sampled heights for the strap outlines\n    const steps = 24;\n    const zs = (z0, z1) => Array.from({ length: steps + 1 }, (_, k) => z0 + ((z1 - z0) * k) / steps);\n    // Side and back straps: flat bars just inside the rings, welded to them\n    const ribZ = zs(strapBottom, ringZ[ringCount - 1]);\n    let rib = replicad.draw([R(ribZ[0]) - rod, ribZ[0]]);\n    ribZ.slice(1).forEach((z) => (rib = rib.lineTo([R(z) - rod, z])));\n    [...ribZ].reverse().forEach((z) => (rib = rib.lineTo([R(z) - rod - strapWidth, z])));\n    const ribSolid = rib\n        .close()\n        .sketchOnPlane(\"XZ\")\n        .extrude(strapThickness)\n        .translate(0, strapThickness / 2, 0);\n    [0, 90, 180].forEach((deg) => members.push(ribSolid.clone().rotate(deg, [0, 0, 0], [0, 0, 1])));\n    // Front plates beside the firebox, outer edge flush with the rings\n    const plateOuterX = plateX + strapThickness;\n    const pz = zs(strapBottom, plateTop);\n    const yo = (z) => -Math.sqrt(R(z) ** 2 - plateOuterX ** 2);\n    let plate = replicad.draw([yo(pz[0]), pz[0]]);\n    pz.slice(1).forEach((z) => (plate = plate.lineTo([yo(z), z])));\n    [...pz].reverse().forEach((z) => (plate = plate.lineTo([yo(z) + frontPlateDepth, z])));\n    const plateSolid = plate.close().sketchOnPlane(\"YZ\").extrude(strapThickness);\n    members.push(plateSolid.clone().translate(plateX, 0, 0));\n    members.push(plateSolid.translate(-plateX - strapThickness, 0, 0));\n    return new Assembly({\n        geometry: replicad.makeCompound(members),\n        color,\n        tags: [\"stainless steel\", \"stone cage\"],\n    });\n}\n"
        }
