                }
              ],
              "interpreterVersion": 1,
              "code": "/**\n * HUUM HIVE Wood 17 firebox door: a steel plate with chamfered top corners\n * and a window opening, also chamfered at the top, that holds the glass.\n * Coordinates are real: x across the stove, z up, the door's back face sits\n * on the firebox front at fireboxFrontY and the door faces -Y.\n */\nfunction run(\n  fireboxFrontY: number = -312.5,\n  width: number = 270,\n  bottom: number = 110,\n  top: number = 434,\n  chamfer: number = 40,\n  windowWidth: number = 174,\n  windowBottom: number = 146,\n  windowTop: number = 380,\n  windowChamfer: number = 25,\n  thickness: number = 15,\n  color: string = \"#4A4C4F\",\n): Assembly {\n  // Rectangle with its two top corners chamfered, in (x, z)\n  const outline = (w: number, z0: number, z1: number, c: number) =>\n    replicad\n      .draw([-w / 2, z0])\n      .lineTo([w / 2, z0])\n      .lineTo([w / 2, z1 - c])\n      .lineTo([w / 2 - c, z1])\n      .lineTo([-w / 2 + c, z1])\n      .lineTo([-w / 2, z1 - c])\n      .close();\n  const plate = outline(width, bottom, top, chamfer).cut(\n    outline(windowWidth, windowBottom, windowTop, windowChamfer),\n  );\n  // The XZ plane extrudes toward -Y, out of the firebox front\n  const door = plate.sketchOnPlane(\"XZ\").extrude(thickness).translate(0, fireboxFrontY, 0);\n  return new Assembly({ geometry: door, color, tags: [\"steel\", \"door\"] });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * HUUM HIVE Wood 17 firebox door: a steel plate with chamfered top corners\n * and a window opening, also chamfered at the top, that holds the glass.\n * Coordinates are real: x across the stove, z up, the door's back face sits\n * on the firebox front at fireboxFrontY and the door faces -Y.\n */\nfunction run(fireboxFrontY = -312.5, width = 270, bottom = 110, top = 434, chamfer = 40, windowWidth = 174, windowBottom = 146, windowTop = 380, windowChamfer = 25, thickness = 15, color = \"#4A4C4F\") {\n    // Rectangle with its two top corners chamfered, in (x, z)\n    const outline = (w, z0, z1, c) => replicad\n        .draw([-w / 2, z0])\n        .lineTo([w / 2, z0])\n        .lineTo([w / 2, z1 - c])\n        .lineTo([w / 2 - c, z1])\n        .lineTo([-w / 2 + c, z1])\n        .lineTo([-w / 2, z1 - c])\n        .close();\n    const plate = outline(width, bottom, top, chamfer).cut(outline(windowWidth, windowBottom, windowTop, windowChamfer));\n    // The XZ plane extrudes toward -Y, out of the firebox front\n    const door = plate.sketchOnPlane(\"XZ\").extrude(thickness).translate(0, fireboxFrontY, 0);\n    return new Assembly({ geometry: door, color, tags: [\"steel\", \"door\"] });\n}\n"
            }
          ],
